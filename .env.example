# ==========================================
# AI Travel Planner 환경변수 설정 예시
# ==========================================
# 1. 이 파일을 복사하여 '.env' 라는 이름의 파일을 만듭니다.
# 2. 아래 GEMINI_API_KEY 항목에 Google AI Studio에서 발급받은 실제 API 키를 입력하세요.
#    (발급 주소: https://aistudio.google.com/app/apikey)

# Google Gemini API Key
GEMINI_API_KEY=your_actual_gemini_api_key_here

# 사용할 Gemini 모델 설정 (.env에서 모델을 직접 확인 및 자유롭게 관리할 수 있습니다)
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask 서버 포트 (기본값: 5000)
PORT=5000

# 서비스 접근 4자리 보안 비밀번호 (기본값: 1234)
ACCESS_PIN=1234
